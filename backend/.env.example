# Copy this file to .env and fill in the real values. Never commit .env —
# only this template belongs in git. Every variable below is read by
# app/config/settings.py (Settings); nothing here is invented.

# ── Application ────────────────────────────────────────────────
APP_NAME=Release Team Intelligenz
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# CORS: JSON-style list of allowed origins, parsed by pydantic-settings.
CORS_ORIGINS=["http://localhost:5173"]

# ── Document ingestion ─────────────────────────────────────────
STORAGE_ROOT=.
MAX_UPLOAD_SIZE_MB=20

# Chunking engine (word counts, not characters or tokens)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── LLM: OpenAI ─────────────────────────────────────────────────
# Required. Also accepted as OPEN_API_KEY (a pre-existing alias this
# app supports) — prefer the correctly spelled name here.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PRICE_PER_1K_TOKENS=0.00002

# Chat model used for AI Test Case Generation and the Knowledge
# Assistant. LLM_MODEL and CHAT_MODEL are interchangeable aliases for
# the same setting.
LLM_MODEL=gpt-5
CHAT_MODEL=gpt-5
LLM_INPUT_PRICE_PER_MILLION_TOKENS=1.25
LLM_OUTPUT_PRICE_PER_MILLION_TOKENS=10.00
# Optional — for future prompt-caching support, not used yet.
LLM_CACHED_INPUT_PRICE_PER_MILLION_TOKENS=
# USD is the source of truth for cost; this is only the display
# conversion rate to INR.
USD_TO_INR_EXCHANGE_RATE=87.00

# Maximum number of test cases the model is asked/allowed to generate
# per AI Test Case Generation call.
MAX_GENERATED_TEST_CASES=5

# ── Knowledge Base Indexing: ChromaDB ───────────────────────────
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=source_of_truth_chunks
CHROMA_WRITE_BATCH_SIZE=1000

# Uploaded Document Embedding: same ChromaDB instance, one collection
# per upload session, named "<prefix>_<upload_session_id>".
UPLOAD_CHROMA_COLLECTION_PREFIX=uploaded_documents

# ── History & Knowledge Assistant storage ───────────────────────
# Every AI operation (indexing, generation) gets its own timestamped
# folder here.
HISTORY_ROOT=data/history
# Knowledge Assistant: one directory per generation under
# <DATABASE_ROOT>/generations/.
DATABASE_ROOT=database

# ── Redmine integration ─────────────────────────────────────────
# Base URL of your Redmine instance (no trailing slash).
REDMINE_URL=
# Personal Redmine API key — Redmine -> My account -> API access key.
REDMINE_API_KEY=
REDMINE_TIMEOUT_SECONDS=30.0
REDMINE_DATA_ROOT=data/redmine

# ── Retrieval Pipeline (Test Plan Generator) ────────────────────
# Legacy single-knob fallback used only when a caller passes a flat
# top_k instead of a full retrieval configuration.
RETRIEVAL_DEFAULT_TOP_K=5

RETRIEVAL_WORKFLOW_CANDIDATE_CHUNKS=20
RETRIEVAL_WORKFLOW_FINAL_CHUNKS=5
RETRIEVAL_HISTORICAL_TEST_CASES_CANDIDATE_CHUNKS=20
RETRIEVAL_HISTORICAL_TEST_CASES_FINAL_CHUNKS=8
RETRIEVAL_HISTORICAL_ISSUES_CANDIDATE_CHUNKS=15
RETRIEVAL_HISTORICAL_ISSUES_FINAL_CHUNKS=5
RETRIEVAL_UPLOADED_DOCUMENTS_CANDIDATE_CHUNKS=10
RETRIEVAL_UPLOADED_DOCUMENTS_FINAL_CHUNKS=3

# ── Hybrid Retrieval (Knowledge Assistant only) ─────────────────
HYBRID_CANDIDATE_CHUNKS=20
RRF_K=60
RERANKED_FINAL_CHUNKS=5
RERANKER_MIN_SCORE=0.08

# ── Logging ──────────────────────────────────────────────────────
# Console + one rotating file per day under this folder.
LOGS_ROOT=logs
