# Copy this file to `.env.local` (git-ignored) and adjust as needed.
#
# Origin (scheme + host + optional port) of the FastAPI backend. The frontend
# only ever calls this API — never OpenAI, MongoDB, or any other service
# directly. The app appends the `/api/v1` path prefix itself, so do NOT
# include it here.
#
# `VITE_*` variables are inlined into the built JavaScript bundle at build
# time and are therefore PUBLIC. Never put an API key, password, AWS
# credential, or any other secret in a `VITE_*` variable.
#
#   Local dev : http://localhost:8000
#   Netlify   : set VITE_API_URL to your deployed backend origin, e.g.
#               https://intelligenz-api.example.com
#               (Site settings -> Build & deploy -> Environment -> Environment variables)
VITE_API_URL=http://localhost:8000
